#!/bin/sh
# OPT.AI Developer Hub -- public-safe guard before every push (owner order "DEVELOPER HUB V1.1 - PUBLIC-SAFE DATA CLEANUP & RELEASE").
# This repository is PUBLIC. Every file version in the commits a push would add is checked (tools/public-safe-guard.mjs); a single
# finding blocks the push. Activate once per clone:  git config core.hooksPath .githooks
z40=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue
  node tools/public-safe-guard.mjs --push "$local_sha" || status=1
done
[ $status -ne 0 ] && echo "pre-push: PUBLIC-SAFE GUARD FAIL -- nothing pushed" >&2
exit $status
